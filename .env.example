# Paste your project URL from the browser (issues page or project page)
# e.g. https://app.plane.so/my-workspace/projects/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx/issues/
PLANE_PROJECT_URL=
# API token: Plane → Profile → API Tokens
PLANE_API_KEY=

# Optional: output path and display
# PLANE_MATRIX_OUTPUT_PATH=~/Pictures/plane_matrix_wallpaper.png
# PLANE_MATRIX_RESOLUTION=1920x1080
#
# Font paths (auto-detected per platform if not set):
#   Linux default:   /usr/share/fonts/noto/NotoSans-Regular.ttf
#   Windows default: C:\Windows\Fonts\segoeui.ttf
#   macOS default:   /System/Library/Fonts/Helvetica.ttc
# PLANE_MATRIX_FONT_PATH=
# PLANE_MATRIX_FONT_BOLD_PATH=
